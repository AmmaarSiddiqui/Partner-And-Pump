{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "rootDir": "src",
    "outDir": "lib",
    "sourceMap": true,

    "strict": false,
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noEmit": false,
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": ["src"]
}
